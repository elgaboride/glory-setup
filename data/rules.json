        { "extremo": "ambos", "tipo": "LSR", "delta_clicks": -1, "porque": "rebote más lento para tracción" }
      ]
    },
    "Medium": { "neumaticos_psi": { "adelante": 0, "atras": 0 }, "efectos": [] },
    "High": {
      "neumaticos_psi": { "adelante": 1, "atras": 1 },
      "efectos": [
        { "extremo": "ambos", "tipo": "LSC", "delta_clicks": -1, "porque": "más soporte en curvas" }
      ]
    }
  },
  "saltos": {
    "si": {
      "neumaticos_psi": { "adelante": 0, "atras": 1 },
      "horquilla": { "tokens": 1, "psi_alternativa": 4 },
      "efectos": [
        { "extremo": "adelante", "tipo": "HSC", "delta_clicks": -1.5, "porque": "no hacer tope en las caídas" },
        { "extremo": "atras", "tipo": "HSC", "delta_clicks": -1.5, "si": { "uso_recorrido_mayor_que": 0.9 }, "porque": "el modelo predice {uso} % de recorrido en el impacto de referencia" },
        { "extremo": "atras", "tipo": "LSR", "delta_clicks": -0.5, "si": { "uso_recorrido_hasta": 0.9 }, "porque": "uso de recorrido {uso} % ≤ 90 %: HSC queda igual y se prioriza el rebote" },
        { "extremo": "ambos", "tipo": "LSR", "delta_clicks": -1, "porque": "que no patee en el despegue" },
        { "extremo": "ambos", "tipo": "HSR", "delta_clicks": -1, "porque": "que no patee en el despegue" }
      ]
    },
    "no": { "neumaticos_psi": { "adelante": 0, "atras": 0 }, "efectos": [] }
  },
  "balance": {
    "trasera_baja": { "extremo": "atras", "tipo": "LSC", "delta_clicks": -1, "porque": "balance: la trasera queda baja respecto a la horquilla" },
    "delantera_baja": { "extremo": "adelante", "tipo": "LSC", "delta_clicks": -1, "porque": "balance: la horquilla queda baja respecto a la trasera" }
  },
  "calibracion": {
    "nota": "Cada registro de la bitácora con estos avisos mueve los parámetros calibrables. 'efecto_mult' multiplica efecto_por_click (< 1 = cada click hace menos de lo supuesto); 'bias' es amortiguación extra permanente (fracción del rango).",
    "limites": { "efecto_mult": [0.5, 1.5], "bias": [-0.25, 0.25], "impacto_mult": [0.6, 1.8], "presion_mult": [0.85, 1.2], "psi_por_punto_sag": [0.5, 6] },
    "feedback": {
